# 건축물대장 · 실거래가 — 공공데이터포털(data.go.kr) 일반 인증키
#
# 1) data.go.kr 로그인 → "건축물대장정보 서비스" 활용 신청 (승인 1~2일)
# 2) 마이페이지 > 오픈API > 인증키에서 "일반 인증키(Decoding)" 복사
# 3) 아래에 붙여 넣고, Vercel 에서는 Settings > Environment Variables 에 같은 이름으로 등록
#
# Encoding 키를 넣어도 서버가 한 번 풀어서 쓰므로 동작하지만, Decoding 키를 권장합니다.
DATA_GO_KR_API_KEY=

# 건축물대장 엔드포인트. 포털에서 서비스 주소가 바뀌면 여기만 고치면 됩니다.
# BLD_RGST_BASE=https://apis.data.go.kr/1613000/BldRgstHubService

# VWorld (국토교통부 공간정보 오픈플랫폼) — 주소→좌표·필지·용도지역
#
# 1) vworld.kr 회원가입 → 오픈API → 인증키 발급 (당일 발급)
# 2) 발급할 때 "서비스 URL"에 배포 도메인을 등록합니다 (예: joonggaetalk.vercel.app)
# 3) 키를 아래에 넣고, Vercel 에서는 Settings > Environment Variables 에 같은 이름으로 등록
VWORLD_API_KEY=

# 서버에서 호출할 때 보낼 Referer. VWorld 키는 등록한 서비스 URL 에서만 동작하므로,
# 2)에서 등록한 주소를 그대로 넣습니다. 비워 두면 Referer 없이 호출합니다.
# VWORLD_REFERER=https://joonggaetalk.vercel.app

# 정기결제 — 포트원 또는 토스페이먼츠 중 하나만 채우면 그쪽으로 붙습니다.
# 카드 정보는 이 서버를 지나가지 않습니다. 브라우저가 PG 결제창에 직접 넣고
# 서버는 PG 가 돌려준 빌링키로만 결제를 요청합니다.

# 포트원 (V2)
PORTONE_API_SECRET=
# 웹훅 서명 검증용. 없으면 웹훅을 받지 않습니다 (위조 웹훅으로 이용기한이 늘어납니다).
PORTONE_WEBHOOK_SECRET=

# 토스페이먼츠
# 서명이 없는 대신 웹훅을 받을 때마다 결제를 재조회해 금액을 대조합니다.
TOSS_SECRET_KEY=
