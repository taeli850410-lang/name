# ── 스튜디오 접근 (권장) ─────────────────────────────────────────
# 비워 두면 /studio 가 누구에게나 열립니다. 배포 전에 반드시 설정하세요.
STUDIO_PASSWORD=

# ── 저장소 (선택) ────────────────────────────────────────────────
# Vercel Marketplace → Upstash Redis 연동 시 자동으로 주입되는 값입니다.
# 없으면 배포 환경에서는 메모리 저장(재시작 시 초기화), 로컬에서는 .data/ 폴더에 저장합니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN 이름도 인식합니다.
# 한 Redis 를 다른 앱과 같이 쓸 때 키가 겹치지 않게 붙이는 이름표(기본 "rera:").
KV_PREFIX=

# ── 자동 요약·태깅 (선택) ─────────────────────────────────────────
# 설정하면 수집된 보도자료의 고객용·중개사용 초안을 Claude 가 작성합니다. (검수 후 발행)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Vercel Cron 보호 (권장) ───────────────────────────────────────
CRON_SECRET=

# ── 시장 데이터 갱신 (선택) ───────────────────────────────────────
# 공공데이터포털 실거래가 API 서비스 키 (아파트 매매·전월세 실거래가 자료)
DATA_GO_KR_KEY=
# 한국은행 ECOS API 키 (기준금리 자동 갱신)
ECOS_API_KEY=

# ── 영상 기사 (테스트용) ──────────────────────────────────────────
# 유튜브 채널 피드 주소를 바꿉니다. 비우면 https://www.youtube.com/feeds/videos.xml 를 씁니다.
# 유튜브에 닿지 않는 환경에서 scripts/dev-feed-server.mjs 로 파이프라인을 확인할 때만 씁니다.
YT_FEED_BASE=
# 재생시간(lengthSeconds)을 읽어 오는 워치 페이지 주소. 비우면 https://www.youtube.com/watch 를 씁니다.
YT_WATCH_BASE=

# ── 사이트 주소 (링크 공유·OG 태그) ───────────────────────────────
NEXT_PUBLIC_SITE_URL=

# 유튜브 영상의 재생시간을 정확히 읽고 싶을 때만 넣습니다(없어도 브리핑은 그대로 돕니다).
# 워치 페이지를 긁는 방식은 배포한 데에서 막혔습니다 — 200 은 오는데 길이 정보가 없는
# 페이지가 옵니다. 공식 API 는 그 다툼이 없고, 하루 열 편이면 할당량의 1/10000 을 씁니다.
# 발급: console.cloud.google.com → API 및 서비스 → YouTube Data API v3 사용 설정 → 사용자 인증 정보 → API 키
YT_API_KEY=
